# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/dentalos

# JWT Secret for Session Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Default Seeded Clinic Administrator Credentials
ADMIN_EMAIL=admin@sharmadental.com
ADMIN_PASSWORD=Password123

# Default Seeded SaaS Super Admin Credentials
SUPERADMIN_EMAIL=superadmin@dentalos.com
SUPERADMIN_PASSWORD=Superadmin123

# SaaS Annual Registration Key
ANNUAL_ACCESS_KEY=ANNUAL365

# Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
